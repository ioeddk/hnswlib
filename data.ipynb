    "# Function to read all best candidate JSON files
def load_all_candidates(base_path='/Users/ioeddk/Dropbox/Fall 2025/Database for LLM/results'):
    """
    Load all best_candidate_gen_*.json files from max_pool_* folders.

    Returns:
        dict: Nested dictionary with structure {max_pool_folder: {generation: json_data}}
    """
    import json
    from pathlib import Path

    candidates = {}
    base_path = Path(base_path)

    # Iterate through all max_pool_* folders
    for pool_dir in base_path.glob('max_pool_*/'):
        if pool_dir.is_dir():
            pool_name = pool_dir.name  # e.g., 'max_pool_20'
            candidates[pool_name] = {}

            # Find all best_candidate_gen_*.json files
            for json_file in pool_dir.glob('best_candidate_gen_*.json'):
                # Extract generation number from filename
                filename = json_file.name
                gen_str = filename.replace('best_candidate_gen_', '').replace('.json', '')
                generation = int(gen_str)

                # Read and parse JSON
                with open(json_file, 'r') as f:
                    data = json.load(f)

                candidates[pool_name][generation] = data

    return candidates

# Usage example:
