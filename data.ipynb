   "source": [
    "BASE_PATH='/Users/ioeddk/Dropbox/Fall 2025/Database for LLM/results'\n",
    "sizes = ['small', 'mid', 'large']\n",
    "\n",
    "for size in sizes:\n",
    "    default = load_result_dataframe(os.path.join(BASE_PATH, size, f'default.txt'))\n",
    "    start = load_result_dataframe(os.path.join(BASE_PATH, size, f'start.txt'))\n",
    "    result = load_result_dataframe(os.path.join(BASE_PATH, size, f'result.txt'))\n",
    "    default.to_csv(os.path.join(BASE_PATH, size, f'default.csv'), index=False)\n",
    "    start.to_csv(os.path.join(BASE_PATH, size, f'start.csv'), index=False)\n",
    "    result.to_csv(os.path.join(BASE_PATH, size, f'result.csv'), index=False)\n",
    "\n",
    "    if size == 'small':\n",
    "        size_print = 'Small'\n",
    "    elif size == 'mid':\n",
    "        size_print = 'Mid'\n",
    "    elif size == 'large':\n",
    "        size_print = 'Large'\n",
    "\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.plot(default['idx'], default['time'], label='Default ZSWAP')\n",
    "    plt.plot(start['idx'], start['time'], label='Starting ZSWAP')\n",
    "    plt.plot(result['idx'], result['time'], label='Optimized ZSWAP')\n",
    "    plt.xlabel('EFS')\n",
    "    plt.ylabel('Time (us)')\n",
    "    plt.title(f'Time vs EFS {size_print}')\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "    plt.show()\n",
    "\n",
    "    "
   ]
